{
  "//": "Workspace packages export their TypeScript source under the @ezvisa/source condition. Type-checking, tsx and Vite read the source; compiled builds and Node at runtime read dist.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "customConditions": ["@ezvisa/source"]
  }
}

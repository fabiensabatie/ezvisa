{
  "name": "@ezvisa/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "@ezvisa/source": "./src/router.ts",
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=@ezvisa/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ezvisa/core": "workspace:*",
    "@ezvisa/db": "workspace:*",
    "@ezvisa/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@trpc/server": "^11.19.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ezvisa/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

# Local development. Copy to .env and adjust. Never commit .env.

DATABASE_URL=postgresql://ezvisa:ezvisa@localhost:5432/ezvisa
# Set to 1 with `pnpm db:local`: its Postgres mixes up queries sent on parallel connections.
DATABASE_POOL_MAX=
# Integration tests empty this database before each test. Never point it at real data.
TEST_DATABASE_URL=postgresql://ezvisa:ezvisa@localhost:5432/ezvisa_test
APP_URL=http://localhost:5173
PORT=3000

# Local S3 from docker compose (Adobe S3Mock). It only supports path-style URLs.
# On Railway these come from the bucket's variables and path style stays off.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=ezvisa-documents
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true

BACKUP_S3_ENDPOINT=http://localhost:9090
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=ezvisa-documents-backup
BACKUP_S3_ACCESS_KEY_ID=local
BACKUP_S3_SECRET_ACCESS_KEY=local
BACKUP_S3_FORCE_PATH_STYLE=true

# Seed only (never production). Leave empty to have the seed generate and print a token.
SEED_OWNER_EMAIL=namtarn@ezvisa.local
SEED_OWNER_TOKEN=
# Optional: fixed token for the "Claude" assistant employee, to connect an MCP client locally.
SEED_ASSISTANT_TOKEN=
